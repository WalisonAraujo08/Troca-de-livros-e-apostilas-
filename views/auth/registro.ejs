<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <div class="auth-header">
      <a href="/" class="logo">📚 Troca<strong>Livros</strong></a>
      <h1>Criar conta gratuita</h1>
      <p>Junte-se a centenas de estudantes trocando livros</p>
    </div>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error">
        <% errors.forEach(e => { %><p>⚠️ <%= e.msg %></p><% }); %>
      </div>
    <% } %>

    <form action="/auth/registro" method="POST" class="auth-form" id="regForm" novalidate>
      <div class="fields-row">
        <div class="field">
          <label for="nome">Nome completo</label>
          <input type="text" id="nome" name="nome" value="<%= old.nome || '' %>"
                 placeholder="Seu nome" required />
          <span class="field-error" id="nomeErr"></span>
        </div>
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" value="<%= old.email || '' %>"
                 placeholder="seu@email.com" required />
          <span class="field-error" id="emailErr"></span>
        </div>
      </div>
      <div class="fields-row">
        <div class="field">
          <label for="curso">Curso</label>
          <input type="text" id="curso" name="curso" value="<%= old.curso || '' %>"
                 placeholder="Ex: Engenharia da Computação" required />
        </div>
        <div class="field">
          <label for="instituicao">Instituição</label>
          <input type="text" id="instituicao" name="instituicao" value="<%= old.instituicao || '' %>"
                 placeholder="Ex: FMU" required />
        </div>
      </div>
      <div class="fields-row">
        <div class="field">
          <label for="senha">Senha</label>
          <div class="password-wrap">
            <input type="password" id="senha" name="senha" placeholder="Mín. 6 caracteres" required />
            <button type="button" class="toggle-pass" onclick="togglePass('senha')">👁</button>
          </div>
          <span class="field-error" id="senhaErr"></span>
        </div>
        <div class="field">
          <label for="confirmar_senha">Confirmar senha</label>
          <div class="password-wrap">
            <input type="password" id="confirmar_senha" name="confirmar_senha" placeholder="Repita a senha" required />
            <button type="button" class="toggle-pass" onclick="togglePass('confirmar_senha')">👁</button>
          </div>
          <span class="field-error" id="confirmErr"></span>
        </div>
      </div>
      <button type="submit" class="btn-primary btn-full">Criar conta</button>
    </form>

    <p class="auth-switch">Já tem conta? <a href="/auth/login">Entrar</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
